GEMINI_API_KEY='gemini api key'
MISTRAL_API_KEY='mistral api key'

# Agent model configuration (optional — defaults to Gemini)
AGENT_MODEL_PROVIDER=google
AGENT_MODEL_ID=gemini-3-flash-preview

# The agent (agno Gemini) reads GOOGLE_API_KEY; it is copied from GEMINI_API_KEY
# only when GOOGLE_API_KEY is not already set in your environment.
# GOOGLE_API_KEY=

# Only needed when AGENT_MODEL_PROVIDER is anthropic / groq / openai
# ANTHROPIC_API_KEY=
# GROQ_API_KEY=
# OPENAI_API_KEY=

# Forensic pipeline and Streamlit app locations (optional)
# FORENSIC_OUTPUT_DIR=pipeline/test_output
# FORENSIC_AGENT_DB=data/forensic_agent.db
# MISTRAL_OCR_CACHE_DIR=pipeline/test_output/mistral_cache
