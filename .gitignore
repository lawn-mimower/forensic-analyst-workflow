# Secrets and local environments
.env
.venv/
venv/

# Python / tooling caches
__pycache__/
*.py[cod]
.pytest_cache/
.ipynb_checkpoints/

# Knowledge graph storage and pipeline outputs
rag_storage/
skills/compliance-checker/outputs/
forensic_data.duckdb
forensic_data.duckdb.wal
forensic_data.sqlite

# Forensic pipeline outputs, skill sweep results and agent sessions
pipeline/test_output/
skills/*/outputs/
data/
*.duckdb
*.duckdb.wal
*.pkl

# Input documents (keep the folder, never commit the files)
user_documents/*
!user_documents/.gitkeep

# Benchmark working files: cached LLM responses, knowledge-graph stores, per-item logs.
# The synthetic benchmark dataset is committed (data/ above would otherwise match it).
benchmarks/.cache/
benchmarks/.work/
!benchmarks/data/
